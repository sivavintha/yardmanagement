# Postgres
DATABASE_URL="postgresql://yard:yard_password@postgres:5432/yard_management?schema=public"

# Auth
JWT_SECRET="change-this-to-a-long-random-string"
JWT_EXPIRES_IN="8h"

# Initial superadmin (created on first boot if no users exist)
SUPERADMIN_NAME="Super Admin"
SUPERADMIN_EMAIL="admin@example.com"
SUPERADMIN_PASSWORD="ChangeMe123!"

# SMTP (server-only, never exposed to the browser or normal settings page)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="reports@example.com"
SMTP_PASS="smtp-password"
SMTP_FROM="Yard Management <reports@example.com>"

# App
PORT="4000"
TZ="Asia/Kolkata"
NODE_ENV="production"
